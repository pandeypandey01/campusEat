<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="CampusEats-Design" version="24.7.0">
  <diagram id="services-diagram" name="CampusEats Services">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="CampusEats — Service Design (Boxes = Services, Arrows = Cross-Service Calls)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="10" width="840" height="30" as="geometry" />
        </mxCell>

        <!-- UserService -->
        <mxCell id="userSvc" value="&lt;b&gt;UserService&lt;/b&gt;&lt;br&gt;Owns: Users, Addresses, AuthCredentials&lt;br&gt;&lt;i&gt;Team: Aditi Rao&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- CatalogueService -->
        <mxCell id="catSvc" value="&lt;b&gt;CatalogueService&lt;/b&gt;&lt;br&gt;Owns: Vendors, MenuItems, Categories&lt;br&gt;&lt;i&gt;Team: Rohan Mehta&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- OrderService (central) -->
        <mxCell id="orderSvc" value="&lt;b&gt;OrderService&lt;/b&gt;&lt;br&gt;Owns: Orders, OrderItems, OrderStatusHistory&lt;br&gt;&lt;i&gt;Team: Sanya Kapoor&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="210" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- PaymentService -->
        <mxCell id="paySvc" value="&lt;b&gt;PaymentService&lt;/b&gt;&lt;br&gt;Owns: Wallets, Transactions, PaymentMethods&lt;br&gt;&lt;i&gt;Team: Karan Verma&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="80" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- DeliveryService -->
        <mxCell id="delSvc" value="&lt;b&gt;DeliveryService&lt;/b&gt;&lt;br&gt;Owns: Riders, Deliveries&lt;br&gt;&lt;i&gt;Team: Ishaan Nair&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="330" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- NotificationService -->
        <mxCell id="notifSvc" value="&lt;b&gt;NotificationService&lt;/b&gt;&lt;br&gt;Owns: Notifications&lt;br&gt;&lt;i&gt;Team: Meera Iyer&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="470" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="e1" value="getUserProfile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="orderSvc" target="userSvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="checkItemAvailability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="orderSvc" target="catSvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="processPayment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="orderSvc" target="paySvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="assignRider" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="orderSvc" target="delSvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="updateOrderStatus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="delSvc" target="orderSvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="sendNotification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="orderSvc" target="notifSvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="sendNotification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="paySvc" target="notifSvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Rule: no two services share data. Each box lists the data (tables) it, and only it, owns." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="700" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
