<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="CampusEats-Design" version="24.7.0">
  <diagram id="schema-diagram" name="CampusEats ER Schema">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="CampusEats — Database Schema (grouped by owning service; dashed = cross-service reference, no FK constraint)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="1100" height="30" as="geometry" />
        </mxCell>

        <!-- ===== UserService swimlane ===== -->
        <mxCell id="grpUser" value="UserService" style="swimlane;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tblUsers" value="Users&#10;--------------------&#10;PK user_id: INT&#10;name: VARCHAR(100)&#10;email: VARCHAR(150) UNIQUE&#10;password_hash: VARCHAR(255)&#10;role: VARCHAR(20)&#10;created_at: DATETIME" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpUser">
          <mxGeometry x="20" y="20" width="150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tblAddresses" value="Addresses&#10;--------------------&#10;PK address_id: INT&#10;FK user_id: INT&#10;label: VARCHAR(30)&#10;line1: VARCHAR(150)&#10;line2: VARCHAR(150)&#10;city_zone: VARCHAR(50)" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpUser">
          <mxGeometry x="170" y="20" width="150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="eUserAddr" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;rounded=0;" edge="1" parent="grpUser" source="tblUsers" target="tblAddresses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== CatalogueService swimlane ===== -->
        <mxCell id="grpCat" value="CatalogueService" style="swimlane;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tblVendors" value="Vendors&#10;--------------------&#10;PK vendor_id: INT&#10;name: VARCHAR(120)&#10;campus_zone: VARCHAR(50)&#10;rating: DECIMAL(2,1)&#10;is_open: BOOLEAN" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpCat">
          <mxGeometry x="20" y="20" width="150" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tblMenuItems" value="MenuItems&#10;--------------------&#10;PK item_id: INT&#10;FK vendor_id: INT&#10;name: VARCHAR(120)&#10;category: VARCHAR(50)&#10;price: DECIMAL(8,2)&#10;available_qty: INT" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpCat">
          <mxGeometry x="190" y="20" width="150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="eVendorItem" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;rounded=0;" edge="1" parent="grpCat" source="tblVendors" target="tblMenuItems">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PaymentService swimlane ===== -->
        <mxCell id="grpPay" value="PaymentService" style="swimlane;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="820" y="60" width="360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tblWallets" value="Wallets&#10;--------------------&#10;PK wallet_id: INT&#10;user_id: INT (ref only)&#10;balance: DECIMAL(10,2)&#10;updated_at: DATETIME" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpPay">
          <mxGeometry x="20" y="20" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tblTransactions" value="Transactions&#10;--------------------&#10;PK transaction_id: INT&#10;FK wallet_id: INT&#10;order_id: INT (ref only)&#10;amount: DECIMAL(10,2)&#10;status: VARCHAR(20)&#10;created_at: DATETIME" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpPay">
          <mxGeometry x="200" y="20" width="160" height="150" as="geometry" />
        </mxCell>
        <mxCell id="eWalletTxn" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;rounded=0;" edge="1" parent="grpPay" source="tblWallets" target="tblTransactions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== OrderService swimlane ===== -->
        <mxCell id="grpOrder" value="OrderService" style="swimlane;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="620" height="280" as="geometry" />
        </mxCell>
        <mxCell id="tblOrders" value="Orders&#10;--------------------&#10;PK order_id: INT&#10;user_id: INT (ref only)&#10;vendor_id: INT (ref only)&#10;delivery_address_id: INT (ref only)&#10;status: VARCHAR(20)&#10;total_amount: DECIMAL(10,2)&#10;created_at: DATETIME" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpOrder">
          <mxGeometry x="20" y="20" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="tblOrderItems" value="OrderItems&#10;--------------------&#10;PK order_item_id: INT&#10;FK order_id: INT&#10;item_id: INT (ref only)&#10;item_name_snapshot: VARCHAR(120)&#10;unit_price_snapshot: DECIMAL(8,2)&#10;quantity: INT" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpOrder">
          <mxGeometry x="230" y="20" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="tblOrderStatusHistory" value="OrderStatusHistory&#10;--------------------&#10;PK history_id: INT&#10;FK order_id: INT&#10;status: VARCHAR(20)&#10;changed_at: DATETIME" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpOrder">
          <mxGeometry x="440" y="20" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eOrderItems" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;rounded=0;" edge="1" parent="grpOrder" source="tblOrders" target="tblOrderItems">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eOrderHist" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;rounded=0;" edge="1" parent="grpOrder" source="tblOrders" target="tblOrderStatusHistory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== DeliveryService swimlane ===== -->
        <mxCell id="grpDel" value="DeliveryService" style="swimlane;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="700" y="360" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="tblRiders" value="Riders&#10;--------------------&#10;PK rider_id: INT&#10;name: VARCHAR(100)&#10;phone: VARCHAR(20)&#10;is_available: BOOLEAN&#10;current_zone: VARCHAR(50)" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpDel">
          <mxGeometry x="20" y="20" width="160" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tblDeliveries" value="Deliveries&#10;--------------------&#10;PK delivery_id: INT&#10;FK rider_id: INT&#10;order_id: INT (ref only)&#10;pickup_vendor_id: INT (ref only)&#10;drop_address_id: INT (ref only)&#10;status: VARCHAR(20)&#10;assigned_at: DATETIME&#10;delivered_at: DATETIME" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpDel">
          <mxGeometry x="200" y="20" width="170" height="190" as="geometry" />
        </mxCell>
        <mxCell id="eRiderDel" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;rounded=0;" edge="1" parent="grpDel" source="tblRiders" target="tblDeliveries">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== NotificationService swimlane ===== -->
        <mxCell id="grpNotif" value="NotificationService" style="swimlane;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="1120" y="360" width="220" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tblNotifications" value="Notifications&#10;--------------------&#10;PK notification_id: INT&#10;user_id: INT (ref only)&#10;type: VARCHAR(30)&#10;payload: TEXT&#10;status: VARCHAR(20)&#10;sent_at: DATETIME" style="shape=table;startSize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="grpNotif">
          <mxGeometry x="20" y="20" width="180" height="160" as="geometry" />
        </mxCell>

        <!-- Cross-service reference lines (dashed, no FK constraint) -->
        <mxCell id="refOrderUser" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="tblOrders" target="tblUsers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="refOrderVendor" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="tblOrders" target="tblVendors">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="refOrderItemMenu" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="tblOrderItems" target="tblMenuItems">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="refTxnOrder" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="tblTransactions" target="tblOrders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="refDelOrder" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="tblDeliveries" target="tblOrders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="refNotifUser" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="tblNotifications" target="tblUsers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend2" value="Solid arrow = real foreign key (within one service). Dashed grey arrow = cross-service reference stored as a plain id (NOT a DB-level FK) — enforced by calling the owning service's API." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1200" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
